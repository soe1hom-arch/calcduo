<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/calcCardBackground"
    android:padding="24dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_preferences"
            app:tint="?attr/calcAccent"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/menu_settings"
            android:textColor="?attr/calcTextPrimary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/btn_settings_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="?attr/calcTextSecondary"
            android:textSize="18sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/calcDivider"
        android:layout_marginBottom="16dp" />

    <!-- Theme Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_theme"
        android:textColor="?attr/calcAccent"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_theme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="true"
        android:layout_marginBottom="20dp"
        app:chipSpacing="8dp"
        app:selectionRequired="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_theme_system"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/theme_system"
            android:textColor="?attr/calcTextPrimary"
            app:chipBackgroundColor="?attr/calcButtonBackground"
            app:chipStrokeColor="?attr/calcDivider" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_theme_light"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/theme_light"
            android:textColor="?attr/calcTextPrimary"
            app:chipBackgroundColor="?attr/calcButtonBackground"
            app:chipStrokeColor="?attr/calcDivider" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_theme_dark"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/theme_dark"
            android:textColor="?attr/calcTextPrimary"
            app:chipBackgroundColor="?attr/calcButtonBackground"
            app:chipStrokeColor="?attr/calcDivider" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_theme_grey"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/theme_grey"
            android:textColor="?attr/calcTextPrimary"
            app:chipBackgroundColor="?attr/calcButtonBackground"
            app:chipStrokeColor="?attr/calcDivider" />

    </com.google.android.material.chip.ChipGroup>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/calcDivider"
        android:layout_marginBottom="16dp" />

    <!-- Palette Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_palette"
        android:textColor="?attr/calcAccent"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_palette"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="true"
        android:layout_marginBottom="20dp"
        app:chipSpacing="8dp"
        app:selectionRequired="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_palette_purple"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/palette_purple"
            android:textColor="?attr/calcTextPrimary"
            app:chipBackgroundColor="?attr/calcButtonBackground"
            app:chipStrokeColor="?attr/calcDivider" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_palette_orange"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/palette_orange"
            android:textColor="?attr/calcTextPrimary"
            app:chipBackgroundColor="?attr/calcButtonBackground"
            app:chipStrokeColor="?attr/calcDivider" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_palette_green"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/palette_green"
            android:textColor="?attr/calcTextPrimary"
            app:chipBackgroundColor="?attr/calcButtonBackground"
            app:chipStrokeColor="?attr/calcDivider" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_palette_blue"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/palette_blue"
            android:textColor="?attr/calcTextPrimary"
            app:chipBackgroundColor="?attr/calcButtonBackground"
            app:chipStrokeColor="?attr/calcDivider" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_palette_pink"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/palette_pink"
            android:textColor="?attr/calcTextPrimary"
            app:chipBackgroundColor="?attr/calcButtonBackground"
            app:chipStrokeColor="?attr/calcDivider" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_palette_grey"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/palette_grey"
            android:textColor="?attr/calcTextPrimary"
            app:chipBackgroundColor="?attr/calcButtonBackground"
            app:chipStrokeColor="?attr/calcDivider" />

    </com.google.android.material.chip.ChipGroup>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/calcDivider"
        android:layout_marginBottom="16dp" />

    <!-- Haptic Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_feedback"
        android:textColor="?attr/calcAccent"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_haptic"
            android:textColor="?attr/calcTextPrimary"
            android:textSize="16sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_haptic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />

    </LinearLayout>

</LinearLayout>
