<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/calcBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/calcBackgroundSecondary"
        app:menu="@menu/note_editor_menu"
        app:navigationIconTint="?attr/calcTextPrimary"
        app:title="@string/notes_title"
        app:titleTextColor="?attr/calcTextPrimary" />

    <EditText
        android:id="@+id/et_note_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@null"
        android:hint="@string/notes_title_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:textColor="?attr/calcTextPrimary"
        android:textColorHint="?attr/calcTextDisabled"
        android:textSize="20sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="20dp"
        android:background="?attr/calcDivider" />

    <EditText
        android:id="@+id/et_note_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@null"
        android:gravity="top|start"
        android:hint="@string/notes_hint"
        android:importantForAutofill="no"
        android:inputType="textMultiLine"
        android:padding="20dp"
        android:textColor="?attr/calcTextPrimary"
        android:textColorHint="?attr/calcTextDisabled"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tv_note_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:paddingHorizontal="20dp"
        android:paddingBottom="12dp"
        android:textColor="?attr/calcTextDisabled"
        android:textSize="11sp" />
</LinearLayout>
