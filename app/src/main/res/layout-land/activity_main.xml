<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_gradient">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            android:elevation="0dp"
            app:title="@string/app_name"
            app:titleTextColor="?attr/colorOnSurface"
            app:navigationIcon="@drawable/ic_menu"
            app:navigationContentDescription="@string/nav_open"
            style="@style/Widget.Material3.Toolbar" />
        <LinearLayout
            android:id="@+id/container_displays"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.40"
            android:orientation="vertical">
            <FrameLayout
                android:id="@+id/panel_tab1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true" />
            <View
                android:id="@+id/panel_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/calcDivider"
                android:visibility="visible" />
            <FrameLayout
                android:id="@+id/panel_tab2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:visibility="visible" />
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/calcDivider" />
        <FrameLayout
            android:id="@+id/container_keyboard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.60">
            <include android:id="@+id/keyboard" layout="@layout/shared_keyboard" />
        </FrameLayout>
    </LinearLayout>
    <!-- Sidebar -->
    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?attr/colorSurface"
        android:orientation="vertical"
        android:elevation="8dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="?attr/colorSurfaceVariant"
            android:gravity="bottom"
            android:orientation="vertical"
            android:padding="24dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="?attr/colorOnSurface"
                android:textSize="28sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/app_tagline"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp" />
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/row_drawer_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:rippleColor="?attr/colorOnSurfaceVariant">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:drawableStartCompat="@android:drawable/ic_menu_edit"
                android:drawablePadding="12dp"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:text="@string/notes_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                app:drawableTint="?attr/colorOnSurface" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
