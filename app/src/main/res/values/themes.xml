<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== BASE THEME (defines attr mappings) ===== -->
    <style name="Theme.CalculatorApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Map custom attrs to actual colors (overridden in child themes) -->
        <item name="calcBackground">@color/bg_primary</item>
        <item name="calcBackgroundSecondary">@color/bg_secondary</item>
        <item name="calcCardBackground">@color/bg_card</item>
        <item name="calcKeyboardBackground">@color/bg_keyboard</item>
        <item name="calcButtonBackground">@color/bg_button</item>
        <item name="calcButtonPressed">@color/bg_button_pressed</item>
        <item name="calcTextPrimary">@color/text_primary</item>
        <item name="calcTextSecondary">@color/text_secondary</item>
        <item name="calcTextDisabled">@color/text_disabled</item>
        <item name="calcAccent">@color/accent_purple</item>
        <item name="calcAccentDark">@color/accent_purple_dark</item>
        <item name="calcAccentPressed">@color/accent_purple_pressed</item>
        <item name="calcDivider">@color/divider_subtle</item>
        <item name="calcDanger">@color/danger</item>
        <item name="calcDangerBackground">@color/danger_bg</item>

        <!-- MD3 theme mapping -->
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurface">@color/bg_keyboard</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/bg_card</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorPrimaryContainer">@color/accent_purple_dark</item>
        <item name="colorOnPrimaryContainer">@color/accent_purple</item>
        <item name="colorSecondaryContainer">@color/bg_button</item>
        <item name="colorOnSecondaryContainer">@color/text_secondary</item>
        <item name="colorTertiary">@color/accent_purple</item>
        <item name="colorOnTertiary">@color/text_primary</item>
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>
    </style>

    <!-- ===== LIGHT THEME (DayNight default) ===== -->
    <style name="Theme.CalculatorApp.Light" parent="Theme.CalculatorApp">
        <!-- Inherits from base which reads from values/colors.xml (light) -->
    </style>

    <!-- ===== DARK THEME ===== -->
    <style name="Theme.CalculatorApp.Dark" parent="Theme.CalculatorApp">
    </style>

    <!-- ===== GREY THEME ===== -->
    <style name="Theme.CalculatorApp.Grey" parent="Theme.CalculatorApp">
        <item name="calcBackground">@color/grey_bg_primary</item>
        <item name="calcBackgroundSecondary">@color/grey_bg_secondary</item>
        <item name="calcCardBackground">@color/grey_bg_card</item>
        <item name="calcKeyboardBackground">@color/grey_bg_keyboard</item>
        <item name="calcButtonBackground">@color/grey_bg_button</item>
        <item name="calcTextPrimary">@color/grey_text_primary</item>
        <item name="calcTextSecondary">@color/grey_text_secondary</item>
        <item name="calcTextDisabled">@color/grey_text_disabled</item>
        <item name="calcDivider">@color/grey_divider</item>
        <item name="calcDangerBackground">@color/grey_danger_bg</item>

        <!-- MD3 overrides for grey -->
        <item name="android:colorBackground">@color/grey_bg_primary</item>
        <item name="colorOnBackground">@color/grey_text_primary</item>
        <item name="colorSurface">@color/grey_bg_keyboard</item>
        <item name="colorOnSurface">@color/grey_text_primary</item>
        <item name="colorSurfaceVariant">@color/grey_bg_card</item>
        <item name="colorOnSurfaceVariant">@color/grey_text_secondary</item>
        <item name="colorSecondaryContainer">@color/grey_bg_button</item>
        <item name="colorOnSecondaryContainer">@color/grey_text_secondary</item>
        <item name="android:statusBarColor">@color/grey_bg_primary</item>
        <item name="android:navigationBarColor">@color/grey_bg_primary</item>
    </style>

    <style name="Theme.CalcDuoSplash" parent="Theme.CalculatorApp">
        <item name="android:windowBackground">@color/accent_purple</item>
    </style>

</resources>
