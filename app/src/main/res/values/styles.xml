<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- CalcDuo Premium Button System -->

    <style name="CalcButtonBase" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:padding">0dp</item>
        <item name="cornerRadius">22dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="elevation">3dp</item>
        <item name="rippleColor">?attr/calcAccent</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:layout_marginVertical">4dp</item>
    </style>

    <!-- Numbers: Dark Surface -->
    <style name="CalcButtonNumber" parent="CalcButtonBase">
        <item name="backgroundTint">?attr/calcButtonBackground</item>
        <item name="android:textColor">?attr/calcTextPrimary</item>
        <item name="android:textSize">28sp</item>
    </style>

    <!-- Operators: Dark Purple -->
    <style name="CalcButtonOperator" parent="CalcButtonBase" tools:targetApi="28">
        <item name="backgroundTint">?attr/calcAccentDark</item>
        <item name="android:textColor">?attr/calcAccent</item>
        <item name="android:textSize">28sp</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">#FF5F00</item>
        <item name="elevation">6dp</item>
        <item name="android:outlineSpotShadowColor">#FF5F00</item>
        <item name="android:outlineAmbientShadowColor">#33FF5F00</item>
    </style>

    <!-- Functions: Gray Surface -->
    <style name="CalcButtonFunction" parent="CalcButtonBase">
        <item name="backgroundTint">?attr/calcButtonBackground</item>
        <item name="android:textColor">?attr/calcTextSecondary</item>
        <item name="android:textSize">22sp</item>
        <item name="elevation">1.5dp</item>
    </style>

    <!-- Equals: Solid Purple - strongest visual -->
    <style name="CalcButtonEquals" parent="CalcButtonBase" tools:targetApi="28">
        <item name="backgroundTint">?attr/calcAccent</item>
        <item name="android:textColor">?attr/calcTextPrimary</item>
        <item name="android:textSize">32sp</item>
        <item name="elevation">8dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">#FF5F00</item>
        <item name="android:outlineSpotShadowColor">#FF5F00</item>
        <item name="android:outlineAmbientShadowColor">#59FF5F00</item>
    </style>
</resources>
